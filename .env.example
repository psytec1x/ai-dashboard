# ============================================
# AI Dashboard — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Clerk (authentication)
# Get your key at https://dashboard.clerk.com → Create Application → Test/Production
# (Dev key works locally; production key for Cloudflare Pages)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- LLM APIs (optional; only needed if you use models not in the default list) ---
# OpenAI
# VITE_OPENAI_API_KEY=sk-...
# Anthropic
# VITE_ANTHROPIC_API_KEY=sk-...
